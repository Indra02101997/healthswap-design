<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>HealthSwap.Api</RootNamespace>
    <Description>HealthSwap Partner API host: REST endpoints (api/openapi.yaml), OAuth/JWT, SDK sessions, MCP agent tools, background workers, admin plane and local demo.</Description>
    <UserSecretsId>healthswap-api-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HealthSwap.Platform\HealthSwap.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)api\openapi.yaml" LogicalName="openapi.yaml" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HealthSwap.Api.Tests" />
  </ItemGroup>
</Project>
