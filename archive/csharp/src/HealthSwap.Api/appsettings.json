{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HealthSwap": "Host=127.0.0.1;Port=55432;Username=postgres;Password=postgres;Database=postgres;SSL Mode=Disable;Maximum Pool Size=16;Timeout=30;Command Timeout=60"
  },
  "Auth": {
    "Issuer": "http://localhost:8080/oauth2",
    "Audience": "healthswap-api",
    "AccessTokenMinutes": 10,
    "SdkSessionMaxSeconds": 900
  },
  "Llm": {
    "Provider": "Mock",
    "Endpoint": null,
    "Deployments": {
      "T3": "hs-t3-classifier",
      "T4": "hs-t4-judge",
      "T5": "hs-t5-explainer",
      "T7": "hs-embeddings"
    },
    "MaxCallsPerTaskPerRun": 5000,
    "EnableExplanationPolish": true,
    "MockFaultEvery": 7,
    "Temperature": 0
  },
  "Graph": { "LlmJudgeUncertain": true },
  "Evaluation": { "InternalBudgetMs": 100, "SuggestionTtlMinutes": 30 },
  "Scheduler": { "Enabled": true, "RecoFinalizerSeconds": 30, "AttributionFinalizerSeconds": 60 },
  "RateLimits": { "Enabled": true, "CartEvaluationsPerSecond": 50, "DefaultPerSecond": 20, "BurstMultiplier": 2 },
  "Webhooks": { "AllowHttpLocalhost": false, "MaxAttemptHours": 24 },
  "Cache": { "Redis": null, "WarmOnStartup": true },
  "Cors": { "Origins": [ "http://localhost:8080" ] }
}
